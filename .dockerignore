# Keep the Docker build context small: only what the image needs.
.git
.github
.venv
.env
.env.*
**/__pycache__
**/*.py[cod]
.mypy_cache
.ruff_cache
.pytest_cache
tests
frontend
# The API serves the widget's JavaScript (GET /widget.js); nothing else from widget/.
widget/*
!widget/widget.js
loadtests
eval
infra
docs
node_modules
