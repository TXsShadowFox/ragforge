# RAGForge settings template.
# `make setup` copies this file to `.env`. Then change the passwords in `.env`.
# Never commit `.env`. Passwords go inside URLs, so use only letters, numbers and dashes.
#
# The app reads `.env` when it runs on your machine (`make dev`, tests).
# Docker Compose reads it too, and swaps `localhost` for the service names.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
READY_CHECK_TIMEOUT_SECONDS=2

# --- PostgreSQL ---
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ragforge
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=ragforge
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/

# --- Qdrant (leave the API key empty for local use) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# --- Object storage (RustFS locally; any S3-compatible service works) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ragforge
S3_SECRET_KEY=change-me-storage
S3_BUCKET=ragforge-documents
S3_REGION=us-east-1

# --- Auth ---
# Signs the login tokens (JWT): at least 32 random characters. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-use-at-least-32-random-characters
JWT_EXPIRE_MINUTES=60

# --- Documents and ingestion ---
MAX_UPLOAD_MB=25
# Chunk size in the embedding model's tokens. bge-small reads at most 512 tokens.
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=8
# Where downloaded models are kept (Docker uses /models, a volume).
MODEL_CACHE_DIR=.cache/models
# Seconds to wait before each retry of a failed job; after the last retry the job is dead.
INGEST_RETRY_DELAYS_SECONDS=[10,60,300]
OUTBOX_POLL_SECONDS=1

# --- LLM: any OpenAI-compatible chat API ---
# Groq (free tier): https://console.groq.com/keys. For a local Ollama use
# LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5:3b, LLM_REASONING_EFFORT=none.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.1
# For "reasoning" models like gpt-oss: none, low, medium or high.
LLM_REASONING_EFFORT=low

# --- Search and chat ---
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
SEARCH_CANDIDATES=20
# Chunks the reranker scores below this are "not relevant" (a value for the model above).
MIN_RERANK_SCORE=-5
CHAT_HISTORY_MESSAGES=6

# --- Answer cache ---
CACHE_TTL_SECONDS=86400
ANSWER_CACHE_COLLECTION=answer_cache
# Reuse an answer for a question at least this similar (0.95 is too low: CLAUDE.md, D40).
SEMANTIC_CACHE_THRESHOLD=0.98

# --- Rate limits (per API key or user, per minute) ---
RATE_LIMIT_FREE_REQUESTS=60
RATE_LIMIT_FREE_QUESTIONS=10
RATE_LIMIT_PRO_REQUESTS=600
RATE_LIMIT_PRO_QUESTIONS=100
LOGIN_ATTEMPTS_PER_MINUTE=5

# --- Cost: the LLM's price in US dollars per million tokens ---
LLM_PRICE_INPUT_PER_MILLION=0.075
LLM_PRICE_OUTPUT_PER_MILLION=0.30

# --- Grafana (dashboards at http://localhost:3001) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
