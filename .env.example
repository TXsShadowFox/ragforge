# RAGForge settings template.
# `make setup` copies this file to `.env`. Then change the passwords in `.env`.
# Never commit `.env`. Passwords go inside URLs, so use only letters, numbers and dashes.
#
# The app reads `.env` when it runs on your machine (`make dev`, tests).
# Docker Compose reads it too, and swaps `localhost` for the service names.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
READY_CHECK_TIMEOUT_SECONDS=2

# --- PostgreSQL ---
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ragforge
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=ragforge
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/

# --- Qdrant (leave the API key empty for local use) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Object storage (RustFS locally; any S3-compatible service works) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ragforge
S3_SECRET_KEY=change-me-storage
S3_BUCKET=ragforge-documents
S3_REGION=us-east-1

# --- Auth ---
# Signs the login tokens (JWT): at least 32 random characters. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-use-at-least-32-random-characters
JWT_EXPIRE_MINUTES=60

# --- Grafana (dashboards at http://localhost:3001) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
